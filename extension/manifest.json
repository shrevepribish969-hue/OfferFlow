{
  "manifest_version": 3,
  "name": "OfferFlow 求职助手",
  "version": "2.2.0",
  "description": "保存个人资料，一键填写招聘网站表单，并支持将职位描述剪藏到 OfferFlow。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*",
    "https://offerflow-web.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OfferFlow 求职助手"
  },
  "options_page": "options.html"
}
