# 请将此文件重命名为 .env，并填入您的 DeepSeek API Key
# DeepSeek API 购买与获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# DeepSeek 官方兼容了 OpenAI 的接口格式，Base URL 如下：
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# 推荐使用的模型名：
# deepseek-chat (通用对话，速度快，适合评测)
# deepseek-coder (代码能力极强)
MODEL_NAME="deepseek-chat"
